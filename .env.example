# Optional provider configuration. Secrets should be stored with keyring in production.
PACTLYN_DATA_DIR=~/.local/share/pactlyn
PACTLYN_OLLAMA_URL=http://127.0.0.1:11434
PACTLYN_OLLAMA_MODEL=llama3.2:3b
PACTLYN_OLLAMA_EMBEDDING_MODEL=nomic-embed-text
PACTLYN_OPENROUTER_MODEL=
PACTLYN_OPENROUTER_ENABLED=false
PACTLYN_RESEND_FROM=
PACTLYN_RESEND_INBOUND_ADDRESS=
